{
  "expo": {
    "name": "reporte-ciudadano",
    "slug": "reporte-ciudadano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reporteciudadano",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Usamos el micrófono para que puedas contar el problema con una nota de voz."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para sacarle una foto al problema que querés reportar.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para marcar dónde está el problema."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para adjuntar una imagen del problema.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-notifications",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyCR1GVpJfxbX48kqId5mfnSmIOuWl9d5yQ"
          
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
